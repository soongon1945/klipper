# Test case for probe:z_virtual_endstop support
CONFIG z_virtual_endstop.cfg
DICTIONARY atmega2560.dict

# Start by homing the printer.
G28
G1 F6000

# The optional upper switch must work without opening a manual session when
# SAVE=0, and ABORT must not queue a stale calibration value.
G1 Z10
ZMAX_PROBE_CALIBRATE PROBE_SPEED=10 SAVE=0
ASSERT_ZMAX_AT_TRIGGER
G1 Z10
ZMAX_PROBE_CALIBRATE PROBE_SPEED=10 SAVE=1
ASSERT_ZMAX_RETRACTED
ABORT
ASSERT_NO_ZMAX_PENDING

# KlipperScreen follows SAVE=1 with ACCEPT to persist the upper reference.
G1 Z10
ZMAX_PROBE_CALIBRATE PROBE_SPEED=10 SAVE=1
ASSERT_ZMAX_RETRACTED
ACCEPT
ASSERT_ZMAX_PENDING

# KlipperScreen uses the probe-specific command on virtual Z endstops.
SET_GCODE_OFFSET Z=0.1
E_OFFSET_APPLY_PROBE
ASSERT_E1_PROBE_PENDING
SET_GCODE_OFFSET Z=0

# Z / X / Y moves
G1 Z1
G1 X1
G1 Y1

# Run bed_mesh_calibrate
BED_MESH_CALIBRATE

# Move again
G1 Z5 X0 Y0

# Do regular probe
PROBE
QUERY_PROBE

# Test PROBE_CALIBRATE
PROBE_CALIBRATE
ABORT
PROBE_CALIBRATE SPEED=7.3
TESTZ Z=-.2
TESTZ Z=-.3
TESTZ Z=+.1
TESTZ Z=++
TESTZ Z=--
TESTZ Z=+
TESTZ Z=-
ACCEPT

# Move again
G1 Z9
