# Test cases on printers with dual carriage and multiple extruders
CONFIG dual_carriage.cfg
DICTIONARY atmega2560.dict

# First home the printer
G90
G28

# Perform a dummy move
G1 X10 F6000

# Runtime acceleration requests must clamp to the configured ceiling instead
# of failing because the merge dropped the cached maximum.
SET_VELOCITY_LIMIT ACCEL=4000
M204 S4000

# Activate alternate carriage
SET_DUAL_CARRIAGE CARRIAGE=1
G1 X190 F6000

# Go back to main carriage
SET_DUAL_CARRIAGE CARRIAGE=0
G1 X20 F6000

# Save dual carriage state
SAVE_DUAL_CARRIAGE_STATE

G1 X50 F6000

# Go back to alternate carriage
SET_DUAL_CARRIAGE CARRIAGE=1
G1 X170 F6000

# Restore dual carriage state
RESTORE_DUAL_CARRIAGE_STATE

# Test changing extruders
G1 X5
T1
G91
G1 X-10 E.2
T0
G91
G1 X20 E.2
G90

# A global Z offset and a redundant activation must not leak into the X/Y
# origin.  The old implementation changed Y180 into a physical Y230 move.
SET_GCODE_OFFSET Z=50
ACTIVATE_EXTRUDER EXTRUDER=extruder
SAVE_GCODE_STATE NAME=global_z_offset
RESTORE_GCODE_STATE NAME=global_z_offset
G1 Y180
SET_GCODE_OFFSET Z=0
G1 Y0

# Editing an inactive T1 offset must not move the active T0 carriage.
SET_GCODE_EOFFSET X=1000 MOVE=1
SET_GCODE_EOFFSET X=0

# Keep SET_GCODE_OFFSET independent from the active nozzle offset.  Combining
# both origins makes the next T0 move use an invalid negative X coordinate.
SET_GCODE_EOFFSET X=50
SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
ACTIVATE_EXTRUDER EXTRUDER=extruder1
SET_GCODE_OFFSET X=0
ACTIVATE_EXTRUDER EXTRUDER=extruder
SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY
G1 X0
SET_GCODE_EOFFSET X=0

# RECORD_GCODE_STATE stores an absolute Z target and must restore G91 after
# moving.  Without the G90 guard this attempts a relative move from Z150 to
# Z300, beyond the fixture's Z range.
G1 Z150
RECORD_GCODE_STATE
G91
RECORD_GCODE_STATE MOVE=1
G90

# Verify that valid COPY and MIRROR moves use the current carriage offsets.
# These positions intentionally permit motion beyond half of the X range.
G1 X0
SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
G1 X80
SET_DUAL_CARRIAGE CARRIAGE=1 MODE=COPY
G1 X110
SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY
G1 X60
SET_DUAL_CARRIAGE CARRIAGE=1 MODE=PRIMARY
G1 X200
SET_DUAL_CARRIAGE CARRIAGE=1 MODE=MIRROR
G1 X105
SET_DUAL_CARRIAGE CARRIAGE=0 MODE=PRIMARY

# Restore a saved T0 position after switching to an offset T1.  The restore
# move must absorb the nozzle offset before extrusion resumes; otherwise the
# next move below is shortened enough to exceed max_extrude_cross_section.
SET_GCODE_EOFFSET X=.61 Y=2.36 Z=.06
G1 X100 Y100
SAVE_GCODE_STATE NAME=filament_failover
T1
RESTORE_GCODE_STATE NAME=filament_failover MOVE=1
M83
G1 X100 Y98 E.2

QUERY_ENDSTOPS

# Servo tests
SET_SERVO servo=my_servo angle=160
SET_SERVO servo=my_servo angle=130

# Verify STEPPER_BUZZ
STEPPER_BUZZ STEPPER=dual_carriage
STEPPER_BUZZ STEPPER=extruder
STEPPER_BUZZ STEPPER=extruder1
