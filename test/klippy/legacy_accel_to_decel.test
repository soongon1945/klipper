# Legacy clients must map onto the current minimum_cruise_ratio model.
CONFIG legacy_accel_to_decel.cfg
DICTIONARY atmega2560.dict

ASSERT_VELOCITY_LIMIT ACCEL=3000 RATIO=0.6 LEGACY=1200

# The conversion must use the configured acceleration ceiling, not the
# larger value requested by the client.
SET_VELOCITY_LIMIT ACCEL=6000 ACCEL_TO_DECEL=1500
ASSERT_VELOCITY_LIMIT ACCEL=3000 RATIO=0.5 LEGACY=1500

SET_VELOCITY_LIMIT ACCEL_TO_DECEL=6000
ASSERT_VELOCITY_LIMIT ACCEL=3000 RATIO=0 LEGACY=3000

SET_VELOCITY_LIMIT MINIMUM_CRUISE_RATIO=0.25
ASSERT_VELOCITY_LIMIT ACCEL=3000 RATIO=0.25 LEGACY=2250
